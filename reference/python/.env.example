# ── SENTINEL configuration ────────────────────────────────────────────────
# Copy to .env and fill in what you have. Everything except the API key is
# optional — connectors fall back to fully-functional mock mode for demos.

# Anthropic (or run `ant auth login` and leave this unset)
ANTHROPIC_API_KEY=

# Model powering the incident commander
SENTINEL_MODEL=claude-opus-4-8

# Domain the web commander runs (devops | finops). The engine is domain-agnostic;
# this only sets the default adapter for the server + watchdog. DevOps is the
# flagship; FinOps can also be run standalone: python -m sentinel.adapters.finops.demo
SENTINEL_DOMAIN=devops

# The service under watch
SENTINEL_SERVICE_URL=http://127.0.0.1:8000
SENTINEL_SERVICE_DIR=./service

# Autonomy: resolutions scoring >= threshold are executed without a human.
# Below it, SENTINEL pauses and asks for approval in the dashboard.
SENTINEL_CONFIDENCE_THRESHOLD=0.80
SENTINEL_MAX_FIX_ITERATIONS=4
SENTINEL_POLL_INTERVAL_SECONDS=2.0

# Dashboard / API port
SENTINEL_PORT=8100

# ── Optional live connectors (mock mode when unset) ──────────────────────
# Slack incoming webhook for incident channel updates
SLACK_WEBHOOK_URL=

# WeKan kanban board (sponsor integration)
WEKAN_URL=
WEKAN_USERNAME=
WEKAN_PASSWORD=
WEKAN_BOARD_ID=
WEKAN_LIST_ID=

# GitHub: set to 1 to push a branch + open a real PR via the `gh` CLI
SENTINEL_GITHUB_PR=0
