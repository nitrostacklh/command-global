# ════════════════════════════════════════════════════════════════════════════
#  command-global — every env var any sub-project reads.
#
#  Copy to `.env` and fill in what you have. Almost everything is optional:
#  the platform is designed to run fully offline with no API key (that is the
#  property the whole test suite rests on — ARCHITECTURE.md §13). Live
#  connectors fall back to functional mock mode when unset.
#
#  Each sub-project also has its own .env.example with the same keys scoped to
#  it; a `.env` at THIS level does not propagate into them automatically. If you
#  run a sub-project directly (`cd sentinel && npm run dev`), put the file there.
# ════════════════════════════════════════════════════════════════════════════


# ── sentinel/ — the NitroStack MCP app (the deliverable) ───────────────────
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=openai

# Transport: stdio | http | dual. Defaults to stdio in dev, dual in production.
# MCP_TRANSPORT_TYPE=stdio
# PORT=3000
# HOST=localhost
# ENABLE_CORS=true

# The autonomy gate. Fixes scoring >= this deploy without a human; below it the
# engine pauses for approval. See ARCHITECTURE.md §5 for the scoring formula.
# SENTINEL_CONFIDENCE_THRESHOLD=0.80


# ── lumina/ — the design canvas (Layer 3) ──────────────────────────────────
# Where the React frontend looks for the FastAPI backend.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Python interpreter used by the Electron shell to spawn srv.py.
# Defaults to lumina/v/Scripts/python.exe if present, else `python`.
# LUMINA_PYTHON=

# Optional export targets for the n8n / Node-RED compilers. The MENTOR plan
# export (/api/export/plan) needs neither — it writes a local file.
# N8N_INSTANCE_URL=http://localhost:5678
# N8N_MCP_TOKEN=
# NODERED_URL=http://localhost:1880


# ── reference/python/ — the frozen prototype (optional) ────────────────────
# Unlike the TS app, the Python prototype DOES call an LLM directly.
# ANTHROPIC_API_KEY=
# SENTINEL_MODEL=claude-opus-4-8
# SENTINEL_DOMAIN=devops
# SENTINEL_SERVICE_URL=http://127.0.0.1:8000
# SENTINEL_SERVICE_DIR=./service
# SENTINEL_MAX_FIX_ITERATIONS=4
# SENTINEL_POLL_INTERVAL_SECONDS=2.0
# SENTINEL_PORT=8100

# Live connectors — all mock when unset.
# SLACK_WEBHOOK_URL=
# WEKAN_URL=
# WEKAN_USERNAME=
# WEKAN_PASSWORD=
# WEKAN_BOARD_ID=
# WEKAN_LIST_ID=
# SENTINEL_GITHUB_PR=0
